{
  "name": "cigarettes-diary/api",
  "description": "PHP backend API for Cigarettes-Diary",
  "version": "1.0.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ben3425",
      "email": "your-email@example.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "firebase/php-jwt": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0 || ^10.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "CigarettesDiary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CigarettesDiary\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR2 src/",
    "lint:fix": "phpcbf --standard=PSR2 src/"
  }
}
